# Application Configuration
SECRET_KEY=docmind-super-secret-jwt-key-change-in-production-2026

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./docmind.db
# DATABASE_URL=postgresql://docmind_user:docmind_secure_password@localhost:5432/docmind_db

# Qdrant Vector Store Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_URL=https://... (For Qdrant Cloud)
# QDRANT_API_KEY=...

# Models Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=google/flan-t5-base

# Optional Free Cloud API Keys (100% Free Tiers - No credit card required)
# Get free Groq key at: https://console.groq.com
# GROQ_API_KEY=gsk_...

# Get free Gemini key at: https://aistudio.google.com
# GEMINI_API_KEY=AIzaSy...

# Optional Tesseract OCR executable path
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
